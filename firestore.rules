rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products collection: public read (get & list), write for admin management
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders collection: customer order submission and admin review (get & list)
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}

